# --- Database ---------------------------------------------------------------
# Inside docker compose the host is "postgres"; for local runs use "localhost".
DATABASE_URL=postgres://family:family@postgres:5432/family?sslmode=disable
POSTGRES_USER=family
POSTGRES_PASSWORD=family
POSTGRES_DB=family
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
HTTP_ADDR=:8080

# --- LLM (OpenRouter, OpenAI-compatible) ------------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-your-key
LLM_MODEL=openrouter/free
LLM_HTTP_REFERER=
LLM_TITLE=Family Budget
LLM_TIMEOUT=60s

# --- Telegram bot (webhook) -------------------------------------------------
# TELEGRAM_WEBHOOK_URL is the public HTTPS base URL, e.g. from localtunnel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_API_BASE_URL=https://api.telegram.org
